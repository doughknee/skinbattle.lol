{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_INTERNAL_URL=http://localhost:8080&& npm run dev --prefix web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-mac",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
