# ── Web (Vite / TanStack Start) ─────────────────────────────────

# Public base URL the browser uses to reach the Go API.
# In production the API is reverse-proxied same-origin under /api.
VITE_API_URL=/api

# Internal URL used during SSR to reach the Go API directly over the
# container/network. The client `/api` path is appended automatically.
API_INTERNAL_URL=http://localhost:8080

# ── Logto (OIDC) ────────────────────────────────────────────────
# Endpoint of your Logto instance.
VITE_LOGTO_ENDPOINT=http://localhost:3001
# The SPA Application ID registered in Logto.
VITE_LOGTO_APP_ID=
# The API resource indicator (audience) of the Go API access tokens.
# Must match the Go API's expected audience.
VITE_LOGTO_RESOURCE=https://api.skinbattle.lol

# ── Node server runtime ─────────────────────────────────────────
# Port the TanStack Start node server listens on.
PORT=3000
