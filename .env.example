# ── Shared / infra ──────────────────────────────────────────────
DATABASE_URL=postgres://skinbattle:skinbattle@localhost:5432/skinbattle?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# ── Logto ───────────────────────────────────────────────────────
# Endpoint of your Logto instance (Coolify service URL in prod)
LOGTO_ENDPOINT=http://localhost:3001
# The API resource indicator you register in Logto (audience of access tokens)
LOGTO_AUDIENCE=https://api.skinbattle.lol
# Optional: Logto M2M app credentials so the API can delete users via the Management API
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# ── Go API ──────────────────────────────────────────────────────
PORT=8080
CORS_ORIGIN=http://localhost:3000

# ── Web (Vite / TanStack Start) ─────────────────────────────────
# Browser talks to the API via same-origin proxy in prod; direct in dev
VITE_API_URL=/api
API_INTERNAL_URL=http://localhost:8080
VITE_LOGTO_ENDPOINT=http://localhost:3001
VITE_LOGTO_APP_ID=
VITE_LOGTO_RESOURCE=https://api.skinbattle.lol

# ── Seed importer (Riot Data Dragon) ────────────────────────────
DDRAGON_VERSION=15.3.1
